@model RegisterViewModel
@using Microsoft.Extensions.Localization
@using Base.Resources
@inject IStringLocalizer<Common> SharedLocalizer
@{
    ViewData["Title"] = SharedLocalizer["Page_Register"].Value;
}
<section data-page="public-register">
    <h1>@SharedLocalizer["Form_Create"]</h1>

    <div asp-validation-summary="ModelOnly" class="text-danger" data-region="form-error-summary"></div>

    <form method="post" asp-area="Public" asp-controller="Account" asp-action="Register">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label asp-for="Email" class="form-label">@SharedLocalizer["Login_Email"]</label>
            <input asp-for="Email" class="form-control" type="email" autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger" data-field-error="Email"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label">@SharedLocalizer["Login_Password"]</label>
            <input asp-for="Password" class="form-control" type="password" autocomplete="new-password" />
            <span asp-validation-for="Password" class="text-danger" data-field-error="Password"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label">@SharedLocalizer["Form_ConfirmPassword"]</label>
            <input asp-for="ConfirmPassword" class="form-control" type="password" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger" data-field-error="ConfirmPassword"></span>
        </div>

        <button type="submit" class="btn btn-primary" data-action="public-register-submit">@SharedLocalizer["Form_Create"]</button>
    </form>
</section>
