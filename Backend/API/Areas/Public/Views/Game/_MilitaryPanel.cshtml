@model API.Areas.Public.ViewModels.GameIndexViewModel
@{
    if (Model.SelectedTileId is null || Model.MyKingdom is null) { return; }
    var tile = Model.State.Tiles.FirstOrDefault(t => t.Id == Model.SelectedTileId);
    if (tile is null || tile.KingdomId != Model.MyKingdom.Id) { return; }

    // For each building on the tile, show army types whose RequiredBuildingTypeId matches
    var trainable = tile.Buildings.SelectMany(b =>
        Model.ArmyTypes
            .Where(at => at.RequiredBuildingTypeId == b.BuildingTypeId)
            .Select(at => (Building: b, ArmyType: at))
    ).ToList();

    var trainError = TempData["TrainError"] as string;
}
<section class="military-panel" data-region="military-panel">
    <h4>Military</h4>
    @if (trainError is not null)
    {
        <div class="alert alert-danger" data-region="train-error">@trainError</div>
    }
    @if (trainable.Count == 0)
    {
        <p class="text-muted">No military buildings on this tile.</p>
    }
    @foreach (var (building, at) in trainable)
    {
        <form method="post"
              action="@Url.Action("Train", "PublicGame", new { area = "Public", id = Model.GameId, selectedTileId = Model.SelectedTileId })"
              class="unit-row"
              data-army-type="@at.Id"
              data-building="@building.Id">
            @Html.AntiForgeryToken()
            <input type="hidden" name="BuildingId" value="@building.Id" />
            <input type="hidden" name="ArmyTypeId" value="@at.Id" />
            <span class="at-name" data-region="at-name">@at.Name</span>
            <span class="at-cost">
                <span class="cost-pill" title="Gold">G @at.TrainingCostGold</span>
                <span class="cost-pill" title="Food">F @at.TrainingCostFood</span>
                <span class="cost-pill" title="Stone">S @at.TrainingCostStone</span>
                <span class="cost-pill" title="Mana">M @at.TrainingCostMana</span>
            </span>
            <span class="at-stats">
                <span class="stat-pill">HP @at.HP</span>
                <span class="stat-pill">ATK @at.Attack</span>
                <span class="stat-pill">INIT @at.Initiative</span>
            </span>
            <button type="submit" class="btn btn-sm btn-primary">Train</button>
        </form>
    }
</section>
