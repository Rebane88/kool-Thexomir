@model API.Areas.Public.ViewModels.GameIndexViewModel
@inject IStringLocalizer<Common> SharedLocalizer
@{
    var myAttack = Model.State.DeclaredAttacks.FirstOrDefault(da =>
        Model.MyKingdom is not null
        && (da.AttackerKingdomId == Model.MyKingdom.Id || da.DefenderKingdomId == Model.MyKingdom.Id));
    var myArmies = Model.State.Armies
        .Where(a => Model.MyKingdom is not null && a.KingdomId == Model.MyKingdom.Id)
        .ToList();
    var unknownLabel = SharedLocalizer["Game_Battle_Unknown"].Value;
    var hpLabel = SharedLocalizer["Game_Battle_HP"].Value;

    // Matches CombatRules.GetMaxArmies: 5 if either tile is a castle, 3 otherwise.
    int maxArmies = 3;
    if (myAttack is not null)
    {
        var targetTile = Model.State.Tiles.FirstOrDefault(t => t.Id == myAttack.TargetTileId);
        var riskedTile = Model.State.Tiles.FirstOrDefault(t => t.Id == myAttack.RiskedTileId);
        if ((targetTile?.IsCastle ?? false) || (riskedTile?.IsCastle ?? false))
            maxArmies = 5;
    }
}
@if (myAttack is null)
{
    <p>@SharedLocalizer["Game_Battle_NoActiveAttack"]</p>
}
else
{
    @if (Model.SelectArmiesError is not null)
    {
        <p class="error" data-region="select-armies-error">@Model.SelectArmiesError</p>
    }
    <p class="text-muted" data-region="select-armies-hint">
        @string.Format(SharedLocalizer["Game_Battle_SelectUpTo"].Value, maxArmies)
    </p>
    <form asp-controller="PublicGame" asp-action="SelectArmies" asp-route-id="@Model.GameId" method="post"
          data-max-armies="@maxArmies">
        @Html.AntiForgeryToken()
        <input type="hidden" name="DeclaredAttackId" value="@myAttack.AttackId" />
        <ul data-list="select-armies">
            @foreach (var army in myArmies)
            {
                var armyType = Model.ArmyTypes.FirstOrDefault(t => t.Id == army.ArmyTypeId);
                var tile = Model.FindTileForArmy(army);
                var locationSuffix = tile is null ? string.Empty : $" — ({tile.CoordQ},{tile.CoordR})";
                <li>
                    <label>
                        <input type="checkbox" name="ArmyIds" value="@army.Id" data-region="select-army-checkbox" />
                        @(armyType?.Name ?? unknownLabel) (@hpLabel @army.CurrentHP / @army.MaxHP)@locationSuffix
                    </label>
                </li>
            }
        </ul>
        <button type="submit">@SharedLocalizer["Game_Battle_ConfirmArmies"]</button>
    </form>
    @* Tiny client-side guard: prevent over-selection, matches React's max-armies behavior. *@
    <script>
        (function () {
            var form = document.querySelector('form[data-max-armies]');
            if (!form) return;
            var max = parseInt(form.getAttribute('data-max-armies'), 10);
            var boxes = form.querySelectorAll('input[type="checkbox"][name="ArmyIds"]');
            function update() {
                var checked = Array.prototype.filter.call(boxes, function (b) { return b.checked; }).length;
                Array.prototype.forEach.call(boxes, function (b) {
                    if (!b.checked) b.disabled = checked >= max;
                });
            }
            Array.prototype.forEach.call(boxes, function (b) { b.addEventListener('change', update); });
            update();
        })();
    </script>
}
