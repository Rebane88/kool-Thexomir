@model API.Areas.Public.ViewModels.GameIndexViewModel
<aside class="action-panel" data-region="action-panel">
    @if (Model.SelectedTileId is null)
    {
        <p>Click a tile to select it.</p>
    }
    else
    {
        var tile = Model.State.Tiles.FirstOrDefault(t => t.Id == Model.SelectedTileId);
        if (tile is null)
        {
            <p>Selected tile not found.</p>
        }
        else
        {
            <h3 data-region="selected-tile">Tile @tile.CoordQ,@tile.CoordR — @tile.TerrainName</h3>
            <p>Owner: @(Model.State.Kingdoms.FirstOrDefault(k => k.Id == tile.KingdomId)?.Name ?? "Unclaimed")</p>
            <p>Buildings: @tile.Buildings.Count</p>
            <partial name="~/Areas/Public/Views/Game/_BuildingPanel.cshtml" model="Model" />
            <partial name="~/Areas/Public/Views/Game/_MilitaryPanel.cshtml" model="Model" />
            @if (Model.MyKingdom is not null
                 && tile.KingdomId.HasValue
                 && tile.KingdomId != Model.MyKingdom.Id
                 && Model.State.CurrentPhase == "Action")
            {
                <partial name="~/Areas/Public/Views/Game/_DeclareAttackPanel.cshtml" model="Model" />
            }
            else if (Model.MyKingdom is not null
                     && tile.KingdomId.HasValue
                     && tile.KingdomId != Model.MyKingdom.Id)
            {
                <partial name="~/Areas/Public/Views/Game/_BattlePlaceholder.cshtml" model="Model" />
            }
        }
    }
</aside>
