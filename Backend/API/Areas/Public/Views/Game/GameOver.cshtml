@model API.Areas.Public.ViewModels.GameOverViewModel
@inject IStringLocalizer<Common> SharedLocalizer
@{
    ViewData["Title"] = SharedLocalizer["Game_Over_Title"].Value;
    Layout = "_PublicLayout";
}

<section data-region="game-over">
    @if (Model.IWon)
    {
        <h1 data-result="win">@SharedLocalizer["Game_Over_Victory"]</h1>
        <p>@SharedLocalizer["Game_Over_VictoryMessage"]</p>
    }
    else if (Model.GameOver.WinnerKingdomId.HasValue)
    {
        <h1 data-result="loss">@SharedLocalizer["Game_Over_Defeat"]</h1>
        <p>@SharedLocalizer["Game_Over_DefeatMessage"]</p>
    }
    else
    {
        <h1 data-result="draw">@SharedLocalizer["Game_Over_Ended"]</h1>
        <p>@SharedLocalizer["Game_Over_EndedMessage"]</p>
    }

    <h2>@SharedLocalizer["Game_Over_FinalStandings"]</h2>
    <table data-table="final-standings">
        <thead>
            <tr>
                <th>@SharedLocalizer["Game_Over_Kingdom"]</th>
                <th>@SharedLocalizer["Game_Over_TilesOwned"]</th>
                <th>@SharedLocalizer["Game_Over_Status"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var k in Model.GameOver.FinalStandings)
            {
                <tr>
                    <td>@k.KingdomName</td>
                    <td>@k.TilesOwned</td>
                    <td>@SharedLocalizer[$"Enum_{k.Status}"]</td>
                </tr>
            }
        </tbody>
    </table>

    <p>@SharedLocalizer["Game_Over_WinCondition"] @SharedLocalizer[$"Enum_{Model.GameOver.WinConditionType}"]</p>

    <a asp-area="Public" asp-controller="Lobby" asp-action="Index" data-action="return-to-lobby">
        @SharedLocalizer["Game_Over_ReturnToLobby"]
    </a>
</section>
