@model API.Areas.Public.ViewModels.GameIndexViewModel
@{
    var me = Model.MyKingdom;
    var currentTurnKingdom = Model.State.Kingdoms.FirstOrDefault(k => k.Id == Model.State.CurrentTurnKingdomId);
    var turnLabel = Model.IsMyTurn ? "Your Turn" : $"{currentTurnKingdom?.Name}'s Turn";
    const int apMax = 4;
}
<header class="game-hud" data-region="hud">
    <div class="hud-resources">
        <dl class="resources">
            @if (me is not null)
            {
                foreach (var r in me.Resources)
                {
                    <dt>@r.ResourceType</dt>
                    <dd data-resource="@r.ResourceType">@r.Amount</dd>
                }
            }
        </dl>
    </div>
    <div class="hud-turn" data-region="turn">
        <span class="turn-label">@turnLabel</span>
        <span class="phase">Phase: @Model.State.CurrentPhase</span>
        <span class="round">Round @Model.State.RoundNumber</span>
        <span class="ap-pips" data-ap="@Model.State.RemainingActionPoints">
            @for (int i = 0; i < apMax; i++)
            {
                @(i < (Model.State.RemainingActionPoints ?? 0) ? "●" : "○")
            }
        </span>
        <span id="turn-timer" class="turn-timer" aria-live="polite"></span>
    </div>
    <div class="hud-actions" data-region="hud-actions">
        <form method="post"
              action="@Url.Action("Spin", "PublicGame", new { area = "Public", id = Model.GameId })"
              class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" data-action="spin" disabled="@(!Model.IsMyTurn ? "disabled" : null)">Gamble</button>
        </form>
        <form method="post"
              action="@Url.Action("EndTurn", "PublicGame", new { area = "Public", id = Model.GameId })"
              class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" data-action="end-turn" disabled="@(!Model.IsMyTurn ? "disabled" : null)">End Turn</button>
        </form>
        <form method="post"
              action="@Url.Action("Abandon", "PublicGame", new { area = "Public", id = Model.GameId })"
              class="d-inline"
              onsubmit="return confirm('Abandon this game?');">
            @Html.AntiForgeryToken()
            <button type="submit" data-action="abandon" class="btn-danger">Abandon</button>
        </form>
    </div>
</header>
