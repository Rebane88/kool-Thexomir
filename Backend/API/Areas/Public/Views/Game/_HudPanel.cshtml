@model API.Areas.Public.ViewModels.GameIndexViewModel
@inject IStringLocalizer<Common> SharedLocalizer
@{
    var me = Model.MyKingdom;
    var currentTurnKingdom = Model.State.Kingdoms.FirstOrDefault(k => k.Id == Model.State.CurrentTurnKingdomId);
    var turnLabel = Model.IsMyTurn
        ? SharedLocalizer["Game_Hud_YourTurn"].Value
        : SharedLocalizer["Game_Hud_PlayerTurn", currentTurnKingdom?.Name ?? string.Empty].Value;
    const int apMax = 4;
}
<header class="game-hud" data-region="hud" data-confirm-abandon="@SharedLocalizer["Game_ConfirmAbandon"]">
    <div class="hud-resources">
        <dl class="resources">
            @if (me is not null)
            {
                foreach (var r in me.Resources)
                {
                    <dt>@SharedLocalizer[$"Enum_{r.ResourceType}"]</dt>
                    <dd data-resource="@r.ResourceType">@r.Amount</dd>
                }
            }
        </dl>
    </div>
    <div class="hud-turn" data-region="turn">
        <span class="turn-label">@turnLabel</span>
        <span class="phase">@SharedLocalizer["Game_Hud_Phase"] @SharedLocalizer[$"Phase_{Model.State.CurrentPhase}"]</span>
        <span class="round">@SharedLocalizer["Game_Hud_Round"] @Model.State.RoundNumber</span>
        <span class="ap-pips" data-ap="@Model.State.RemainingActionPoints">
            @for (int i = 0; i < apMax; i++)
            {
                @(i < (Model.State.RemainingActionPoints ?? 0) ? "●" : "○")
            }
        </span>
        <span id="turn-timer" class="turn-timer" aria-live="polite"></span>
    </div>
    <div class="hud-actions" data-region="hud-actions">
        <form method="post"
              action="@Url.Action("Spin", "PublicGame", new { area = "Public", id = Model.GameId })"
              class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" data-action="spin" disabled="@(!Model.IsMyTurn ? "disabled" : null)">@SharedLocalizer["Game_Hud_Gamble"]</button>
        </form>
        <form method="post"
              action="@Url.Action("EndTurn", "PublicGame", new { area = "Public", id = Model.GameId })"
              class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" data-action="end-turn" disabled="@(!Model.IsMyTurn ? "disabled" : null)">@SharedLocalizer["Game_Hud_EndTurn"]</button>
        </form>
        <form method="post"
              action="@Url.Action("Abandon", "PublicGame", new { area = "Public", id = Model.GameId })"
              class="d-inline"
              onsubmit="return confirm(this.closest('[data-confirm-abandon]').dataset.confirmAbandon);">
            @Html.AntiForgeryToken()
            <button type="submit" data-action="abandon" class="btn-danger">@SharedLocalizer["Game_Hud_Abandon"]</button>
        </form>
    </div>
</header>
