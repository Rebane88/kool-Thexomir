@model API.Areas.Public.ViewModels.GameIndexViewModel
@inject IStringLocalizer<Common> SharedLocalizer
@{
    var battle = Model.LastBattleResult;
}
@if (battle is not null)
{
    <section data-region="post-battle">
        <h3>@SharedLocalizer["Game_PostBattle_Title"]</h3>
        <p data-outcome="@battle.Outcome">@SharedLocalizer["Game_PostBattle_Outcome"] @battle.Outcome</p>
        @if (battle.TileCapturedId != Guid.Empty)
        {
            <p>@SharedLocalizer["Game_PostBattle_TileCaptured"]</p>
        }
        <table data-table="battle-rounds">
            <thead>
                <tr>
                    <th>@SharedLocalizer["Game_PostBattle_Round"]</th>
                    <th>@SharedLocalizer["Game_PostBattle_Initiative"]</th>
                    <th>@SharedLocalizer["Game_PostBattle_Damage"]</th>
                    <th>@SharedLocalizer["Game_PostBattle_AttackerHP"]</th>
                    <th>@SharedLocalizer["Game_PostBattle_DefenderHP"]</th>
                    <th>@SharedLocalizer["Game_PostBattle_Destroyed"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var round in battle.Rounds)
                {
                    <tr>
                        <td>@round.RoundNumber</td>
                        <td>@round.InitiativeWinner</td>
                        <td>@round.DamageDealt</td>
                        <td>@round.AttackerArmyHPAfter</td>
                        <td>@round.DefenderArmyHPAfter</td>
                        <td>@(round.ArmyDestroyedId?.ToString() ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
}
