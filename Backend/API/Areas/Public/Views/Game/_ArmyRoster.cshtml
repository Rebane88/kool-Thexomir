@model API.Areas.Public.ViewModels.GameIndexViewModel
@using Application.Services.GameInitialization.DTOs.V1
@inject IStringLocalizer<Common> SharedLocalizer
@{
    var me = Model.MyKingdom;
    var myArmies = me is null
        ? new List<ArmyDto>()
        : Model.State.Armies.Where(a => a.KingdomId == me.Id).ToList();
    var unknownLabel = SharedLocalizer["Game_Roster_Unknown"].Value;
    var buildingLabel = SharedLocalizer["Game_Roster_Building"].Value;
    var atLabel = SharedLocalizer["Game_Roster_At"].Value;
}
<details class="army-roster" data-region="army-roster" open>
    <summary>@SharedLocalizer["Game_Roster_Title"] (@myArmies.Count)</summary>
    @if (myArmies.Count == 0)
    {
        <p class="text-muted">@SharedLocalizer["Game_Roster_Empty"]</p>
    }
    else
    {
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>@SharedLocalizer["Game_Roster_Type"]</th>
                    <th>@SharedLocalizer["Game_Roster_HP"]</th>
                    <th>@SharedLocalizer["Game_Roster_Location"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var army in myArmies)
                {
                    var armyType = Model.ArmyTypes.FirstOrDefault(t => t.Id == army.ArmyTypeId);
                    var tile = Model.FindTileForArmy(army);
                    var building = tile?.Buildings.FirstOrDefault(b => b.Id == army.BuildingId);
                    var locationLabel = tile is null
                        ? "—"
                        : $"{building?.BuildingName ?? buildingLabel} {atLabel} ({tile.CoordQ},{tile.CoordR})";
                    <tr data-army-id="@army.Id"
                        data-army-type="@(armyType?.Name ?? string.Empty)"
                        data-army-hp="@army.CurrentHP/@army.MaxHP">
                        <td data-region="army-type">@(armyType?.Name ?? unknownLabel)</td>
                        <td data-region="army-hp">@army.CurrentHP / @army.MaxHP</td>
                        <td data-region="army-location">@locationLabel</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</details>
