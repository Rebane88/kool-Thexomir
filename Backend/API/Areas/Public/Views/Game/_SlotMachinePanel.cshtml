@model API.Areas.Public.ViewModels.GameIndexViewModel
@inject IStringLocalizer<Common> SharedLocalizer
@{
    var outcome = TempData.Peek("SpinOutcome") as int?;
    var apAfter = TempData.Peek("SpinApAfter") as int?;
    var goldAfter = TempData.Peek("SpinGoldAfter") as int?;
    var goldSpent = TempData.Peek("SpinGoldSpent") as int?;
    var spinError = TempData["SpinError"] as string;
}
@if (outcome.HasValue)
{
    TempData.Remove("SpinOutcome");
    TempData.Remove("SpinApAfter");
    TempData.Remove("SpinGoldAfter");
    TempData.Remove("SpinGoldSpent");
    <div class="slot-machine-result alert alert-info" data-region="slot-machine-result">
        <strong>@SharedLocalizer["Game_Slot_SpinResult"]</strong>
        <span data-region="spin-outcome">@SharedLocalizer["Game_Slot_Outcome"] @outcome</span>
        <span data-region="spin-gold-spent">@SharedLocalizer["Game_Slot_Spent"] @goldSpent @SharedLocalizer["Game_Slot_Gold"]</span>
        <span data-region="spin-gold-after">@SharedLocalizer["Game_Slot_GoldNow"] @goldAfter</span>
        <span data-region="spin-ap-after">@SharedLocalizer["Game_Slot_ApNow"] @apAfter</span>
    </div>
}
@if (spinError is not null)
{
    <div class="alert alert-danger" data-region="spin-error">@spinError</div>
}
