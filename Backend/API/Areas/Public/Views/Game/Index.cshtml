@model API.Areas.Public.ViewModels.GameIndexViewModel
@using API.Areas.Public.ViewModels
@inject IStringLocalizer<Common> SharedLocalizer
@{
    ViewData["Title"] = SharedLocalizer["Page_Game"].Value;
    Layout = "_PublicLayout";
}
<partial name="~/Areas/Public/Views/Game/_HudPanel.cshtml" model="Model" />
<partial name="~/Areas/Public/Views/Game/_StandingsPanel.cshtml" model="Model" />
<partial name="~/Areas/Public/Views/Game/_SlotMachinePanel.cshtml" model="Model" />
@if (Model.GetBattleStep() != BattleWizardStep.None)
{
    <partial name="~/Areas/Public/Views/Game/_BattleWizardPanel.cshtml" model="Model" />
}
<main class="game-main"
      data-confirm-abandon="@SharedLocalizer["Game_ConfirmAbandon"]"
      data-timer-expired="@SharedLocalizer["Game_TimerExpired"]">
    <partial name="~/Areas/Public/Views/Game/_HexMap.cshtml" model="Model" />
    <partial name="~/Areas/Public/Views/Game/_ActionPanel.cshtml" model="Model" />
</main>
<partial name="~/Areas/Public/Views/Game/_ArmyRoster.cshtml" model="Model" />
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@@8/dist/browser/signalr.min.js"
            data-region="signalr-script"></script>
    <script>
        (function () {
            var gameId = '@Model.GameId';
            var connection = new signalR.HubConnectionBuilder()
                .withUrl('/hubs/game?gameId=' + gameId)
                .withAutomaticReconnect()
                .configureLogging(signalR.LogLevel.Warning)
                .build();

            var reloadPending = false;
            function reload() {
                if (reloadPending) return;
                reloadPending = true;
                setTimeout(function () { window.location.reload(); }, 200);
            }

            connection.on('turnAdvanced', reload);
            connection.on('phaseChanged', reload);
            connection.on('turnStarted', reload);
            connection.on('roundStarted', reload);
            connection.on('buildingPlaced', reload);
            connection.on('armyTrained', reload);
            connection.on('slotMachineSpun', reload);
            connection.on('attackDeclared', reload);
            connection.on('armiesSelected', reload);
            connection.on('lineupSet', reload);
            connection.on('battleResolved', reload);
            connection.on('gameOver', reload);
            // gameStateSnapshot is intentionally NOT handled: the hub pushes a snapshot
            // to every newly-connected client (see GameHub.OnConnectedAsync), which would
            // cause an infinite reload loop for this server-rendered page since the GET
            // already returns the latest state. Snapshots are only meaningful to SPA clients.
            connection.on('turnAutoSkipped', reload);

            connection.start().catch(function (err) { console.error('SignalR error:', err); });
        })();
    </script>
        @if (Model.State.TurnDeadline.HasValue)
        {
            <script>
                (function () {
                    var deadlineMs = new Date('@Model.State.TurnDeadline.Value.ToString("O")').getTime();
                    var timerEl = document.getElementById('turn-timer');
                    if (!timerEl || !deadlineMs) return;

                    var interval;
                    function tick() {
                        var remaining = Math.max(0, Math.ceil((deadlineMs - Date.now()) / 1000));
                        var m = Math.floor(remaining / 60);
                        var s = remaining % 60;
                        timerEl.textContent = m + ':' + (s < 10 ? '0' : '') + s;

                        timerEl.className = 'turn-timer';
                        if (remaining === 0) {
                            var gameMain = document.querySelector('.game-main');
                            timerEl.textContent = gameMain ? gameMain.dataset.timerExpired : '';
                            timerEl.classList.add('turn-timer--expired');
                            clearInterval(interval);
                        } else if (remaining <= 10) {
                            timerEl.classList.add('turn-timer--critical');
                        } else if (remaining <= 30) {
                            timerEl.classList.add('turn-timer--warning');
                        }
                    }

                    tick();
                    interval = setInterval(tick, 1000);
                })();
            </script>
        }
}
