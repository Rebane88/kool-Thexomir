@model API.Areas.Public.ViewModels.GameIndexViewModel
@using API.Areas.Public.ViewModels
@inject IStringLocalizer<Common> SharedLocalizer
@{
    ViewData["Title"] = SharedLocalizer["Page_Game"].Value;
    Layout = "_PublicLayout";
}
<partial name="~/Areas/Public/Views/Game/_HudPanel.cshtml" model="Model" />
<partial name="~/Areas/Public/Views/Game/_StandingsPanel.cshtml" model="Model" />
<partial name="~/Areas/Public/Views/Game/_SlotMachinePanel.cshtml" model="Model" />
@if (Model.GetBattleStep() != BattleWizardStep.None)
{
    <partial name="~/Areas/Public/Views/Game/_BattleWizardPanel.cshtml" model="Model" />
}
<main class="game-main"
      data-confirm-abandon="@SharedLocalizer["Game_ConfirmAbandon"]"
      data-timer-expired="@SharedLocalizer["Game_TimerExpired"]">
    <partial name="~/Areas/Public/Views/Game/_HexMap.cshtml" model="Model" />
    <partial name="~/Areas/Public/Views/Game/_ActionPanel.cshtml" model="Model" />
</main>
<partial name="~/Areas/Public/Views/Game/_ArmyRoster.cshtml" model="Model" />
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@@8/dist/browser/signalr.min.js"
            data-region="signalr-script"></script>
    <script>
        (function () {
            var gameId = '@Model.GameId';
            var connection = new signalR.HubConnectionBuilder()
                .withUrl('/hubs/game?gameId=' + gameId)
                .withAutomaticReconnect()
                .configureLogging(signalR.LogLevel.Warning)
                .build();

            var reloadPending = false;
            function reload() {
                if (reloadPending) return;
                reloadPending = true;
                setTimeout(function () { window.location.reload(); }, 200);
            }

            connection.on('turnAdvanced', reload);
            connection.on('phaseChanged', reload);
            connection.on('turnStarted', reload);
            connection.on('roundStarted', reload);
            connection.on('buildingPlaced', reload);
            connection.on('armyTrained', reload);
            connection.on('slotMachineSpun', reload);
            connection.on('attackDeclared', reload);
            connection.on('armiesSelected', reload);
            connection.on('lineupSet', reload);
            connection.on('gameOver', reload);

            // Battle summary for the non-submitting player (Player A).
            // The submitter (Player B) gets _PostBattlePanel rendered server-side from
            // TempData["LastBattleResult"] after their POST returns. Player A only sees
            // the BattleResolved hub event, so we stash the payload in sessionStorage
            // and reload — the page-load handler below will then render the summary
            // client-side from the stashed JSON.
            connection.on('battleResolved', function (battleResult) {
                try {
                    sessionStorage.setItem('mvc.lastBattleResult', JSON.stringify(battleResult));
                } catch (e) { /* sessionStorage unavailable — reload-only fallback */ }
                reload();
            });
            // gameStateSnapshot is intentionally NOT handled: the hub pushes a snapshot
            // to every newly-connected client (see GameHub.OnConnectedAsync), which would
            // cause an infinite reload loop for this server-rendered page since the GET
            // already returns the latest state. Snapshots are only meaningful to SPA clients.
            connection.on('turnAutoSkipped', reload);

            connection.start().catch(function (err) { console.error('SignalR error:', err); });

            // Render the post-battle summary on page load if the server didn't already
            // (i.e. the submitter gets _PostBattlePanel from TempData; the other player
            // gets the payload via sessionStorage stashed by the battleResolved handler).
            var i18n = {
                title: '@SharedLocalizer["Game_PostBattle_Title"].Value',
                outcome: '@SharedLocalizer["Game_PostBattle_Outcome"].Value',
                tileCaptured: '@SharedLocalizer["Game_PostBattle_TileCaptured"].Value',
                round: '@SharedLocalizer["Game_PostBattle_Round"].Value',
                initiative: '@SharedLocalizer["Game_PostBattle_Initiative"].Value',
                damage: '@SharedLocalizer["Game_PostBattle_Damage"].Value',
                attackerHp: '@SharedLocalizer["Game_PostBattle_AttackerHP"].Value',
                defenderHp: '@SharedLocalizer["Game_PostBattle_DefenderHP"].Value',
                destroyed: '@SharedLocalizer["Game_PostBattle_Destroyed"].Value',
                outcomeAttackerWon: '@SharedLocalizer["Enum_AttackerWon"].Value',
                outcomeDefenderWon: '@SharedLocalizer["Enum_DefenderWon"].Value'
            };
            (function renderStashedBattle() {
                // Skip if server already rendered _PostBattlePanel.
                if (document.querySelector('[data-region="post-battle"]')) {
                    sessionStorage.removeItem('mvc.lastBattleResult');
                    return;
                }
                var json = sessionStorage.getItem('mvc.lastBattleResult');
                if (!json) return;
                var battle;
                try { battle = JSON.parse(json); } catch (e) { sessionStorage.removeItem('mvc.lastBattleResult'); return; }
                sessionStorage.removeItem('mvc.lastBattleResult');

                var section = document.createElement('section');
                section.setAttribute('data-region', 'post-battle');

                var h3 = document.createElement('h3');
                h3.textContent = i18n.title;
                section.appendChild(h3);

                var outcomeLabel = battle.outcome === 'AttackerWon'
                    ? i18n.outcomeAttackerWon
                    : (battle.outcome === 'DefenderWon' ? i18n.outcomeDefenderWon : battle.outcome);
                var pOutcome = document.createElement('p');
                pOutcome.setAttribute('data-outcome', battle.outcome || '');
                pOutcome.textContent = i18n.outcome + ' ' + outcomeLabel;
                section.appendChild(pOutcome);

                if (battle.tileCapturedId && battle.tileCapturedId !== '00000000-0000-0000-0000-000000000000') {
                    var pCaptured = document.createElement('p');
                    pCaptured.textContent = i18n.tileCaptured;
                    section.appendChild(pCaptured);
                }

                var table = document.createElement('table');
                table.setAttribute('data-table', 'battle-rounds');
                var thead = document.createElement('thead');
                var headRow = document.createElement('tr');
                [i18n.round, i18n.initiative, i18n.damage, i18n.attackerHp, i18n.defenderHp, i18n.destroyed]
                    .forEach(function (label) {
                        var th = document.createElement('th');
                        th.textContent = label;
                        headRow.appendChild(th);
                    });
                thead.appendChild(headRow);
                table.appendChild(thead);

                var tbody = document.createElement('tbody');
                (battle.rounds || []).forEach(function (round) {
                    var tr = document.createElement('tr');
                    [
                        round.roundNumber,
                        round.initiativeWinner,
                        round.damageDealt,
                        round.attackerArmyHPAfter,
                        round.defenderArmyHPAfter,
                        round.armyDestroyedId || '—'
                    ].forEach(function (cell) {
                        var td = document.createElement('td');
                        td.textContent = cell;
                        tr.appendChild(td);
                    });
                    tbody.appendChild(tr);
                });
                table.appendChild(tbody);
                section.appendChild(table);

                // Insert at the top of <main> so it's visible alongside the map.
                var target = document.querySelector('.game-main') || document.body;
                target.parentNode.insertBefore(section, target);
            })();
        })();
    </script>
        @if (Model.State.TurnDeadline.HasValue)
        {
            <script>
                (function () {
                    var deadlineMs = new Date('@Model.State.TurnDeadline.Value.ToString("O")').getTime();
                    var timerEl = document.getElementById('turn-timer');
                    if (!timerEl || !deadlineMs) return;

                    var interval;
                    function tick() {
                        var remaining = Math.max(0, Math.ceil((deadlineMs - Date.now()) / 1000));
                        var m = Math.floor(remaining / 60);
                        var s = remaining % 60;
                        timerEl.textContent = m + ':' + (s < 10 ? '0' : '') + s;

                        timerEl.className = 'turn-timer';
                        if (remaining === 0) {
                            var gameMain = document.querySelector('.game-main');
                            timerEl.textContent = gameMain ? gameMain.dataset.timerExpired : '';
                            timerEl.classList.add('turn-timer--expired');
                            clearInterval(interval);
                        } else if (remaining <= 10) {
                            timerEl.classList.add('turn-timer--critical');
                        } else if (remaining <= 30) {
                            timerEl.classList.add('turn-timer--warning');
                        }
                    }

                    tick();
                    interval = setInterval(tick, 1000);
                })();
            </script>
        }
}
