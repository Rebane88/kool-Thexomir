@model LoginViewModel
@using Microsoft.Extensions.Localization
@using Base.Resources
@inject IStringLocalizer<Common> Localizer
@{
    Layout = null;
    ViewData["Title"] = Localizer["Login_Title"].Value;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Realms of Ash — @Localizer["Login_Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            margin: 0;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #111113;
            color: #18181b;
            font-size: 0.875rem;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
        }
        .login-card {
            background: #fff;
            border-radius: 12px;
            padding: 2.5rem 2rem;
            width: 100%;
            max-width: 380px;
            box-shadow: 0 25px 50px rgba(0,0,0,0.25);
        }
        .login-brand {
            font-weight: 600;
            font-size: 0.8rem;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            color: #71717a;
            text-align: center;
            margin-bottom: 1.5rem;
        }
        .login-card .form-label {
            font-size: 0.75rem;
            font-weight: 600;
            color: #3f3f46;
        }
        .login-card .form-control {
            font-size: 0.85rem;
            border-radius: 6px;
            border: 1px solid #d4d4d8;
            padding: 0.5rem 0.7rem;
        }
        .login-card .form-control:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 2px rgba(99,102,241,0.15);
        }
        .login-btn {
            width: 100%;
            padding: 0.55rem;
            border-radius: 6px;
            font-size: 0.85rem;
            font-weight: 600;
            border: none;
            background: #6366f1;
            color: #fff;
            cursor: pointer;
            transition: background 0.15s;
        }
        .login-btn:hover { background: #818cf8; }
        .login-alt {
            margin-top: 1rem;
            text-align: center;
            font-size: 0.8rem;
        }
        .login-alt a {
            color: #6366f1;
            text-decoration: none;
        }
        .login-alt a:hover { text-decoration: underline; }
        .login-error {
            background: #fee2e2;
            color: #991b1b;
            border: 1px solid #fecaca;
            border-radius: 6px;
            padding: 0.5rem 0.75rem;
            font-size: 0.8rem;
            margin-bottom: 1rem;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="login-brand">Realms of Ash</div>

        <div asp-validation-summary="All" class="login-error" style="display:@(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")"></div>

        <form method="post" asp-area="Root" asp-controller="Account" asp-action="Login"
              asp-route-returnUrl="@Model.ReturnUrl">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label asp-for="Email" class="form-label">@Localizer["Login_Email"]</label>
                <input asp-for="Email" class="form-control" type="email"
                       autocomplete="username" placeholder="admin@example.com" />
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label">@Localizer["Login_Password"]</label>
                <input asp-for="Password" class="form-control" type="password"
                       autocomplete="current-password" />
            </div>
            <button type="submit" class="login-btn">@Localizer["Login_SignIn"]</button>
        </form>
        <div class="login-alt">
            <a asp-area="Public" asp-controller="Account" asp-action="Login">@Localizer["Login_GoToPublic"]</a>
        </div>
    </div>
</body>
</html>