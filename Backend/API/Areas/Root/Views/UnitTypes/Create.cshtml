@{
    ViewData["Title"] = "Create Unit Type";
}

<h2>Create Unit Type</h2>
<hr />

<form method="post" asp-action="Create">
    <div class="row g-3" style="max-width: 600px;">

        <div class="col-12">
            <label class="form-label fw-semibold">Name (English)</label>
            <input type="text" name="NameEn" class="form-control" required />
        </div>

        <div class="col-md-6">
            <label class="form-label">Base Strength</label>
            <input type="number" name="BaseStrength" class="form-control" value="0" required />
        </div>

        <div class="col-md-6">
            <label class="form-label">Upkeep (food/turn)</label>
            <input type="number" name="Upkeep" class="form-control" value="0" required />
        </div>

        <div class="col-12"><hr class="my-1" /><small class="text-muted">Recruitment Costs</small></div>

        <div class="col-md-4">
            <label class="form-label">Gold</label>
            <input type="number" name="GoldCost" class="form-control" value="0" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Food</label>
            <input type="number" name="FoodCost" class="form-control" value="0" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Wood</label>
            <input type="number" name="WoodCost" class="form-control" value="0" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Stone</label>
            <input type="number" name="StoneCost" class="form-control" value="0" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Mana</label>
            <input type="number" name="ManaCost" class="form-control" value="0" />
        </div>

        <div class="col-12"><hr class="my-1" /></div>

        <div class="col-12">
            <label class="form-label">Description</label>
            <textarea name="Description" class="form-control" rows="2"></textarea>
        </div>

        <div class="col-12">
            <label class="form-label">Icon URL</label>
            <input type="text" name="IconUrl" class="form-control" />
        </div>

        <div class="col-12">
            <button type="submit" class="btn btn-primary">Create</button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
        </div>

    </div>
</form>
