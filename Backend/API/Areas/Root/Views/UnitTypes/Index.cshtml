@model IEnumerable<Domain.Military.UnitType>
@{
    ViewData["Title"] = "Unit Types";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Unit Types</h2>
    <a asp-action="Create" class="btn btn-primary">Add Unit Type</a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="table-responsive">
    <table class="table table-striped table-sm">
        <thead>
            <tr>
                <th>Name</th>
                <th>Strength</th>
                <th>Gold</th>
                <th>Food</th>
                <th>Wood</th>
                <th>Stone</th>
                <th>Mana</th>
                <th>Upkeep</th>
                <th>Description</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name.Translate("en")</td>
                    <td>@item.BaseStrength</td>
                    <td>@item.GoldCost</td>
                    <td>@item.FoodCost</td>
                    <td>@item.WoodCost</td>
                    <td>@item.StoneCost</td>
                    <td>@item.ManaCost</td>
                    <td>@item.Upkeep</td>
                    <td>@item.Description</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form method="post" asp-action="Delete" asp-route-id="@item.Id" class="d-inline"
                              onsubmit="return confirm('Delete this unit type?')">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
