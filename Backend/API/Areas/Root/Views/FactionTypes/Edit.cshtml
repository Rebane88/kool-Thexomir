@model dynamic
@{
    ViewData["Title"] = "Edit Faction Type";
}

<h2>Edit Faction Type</h2>
<hr />

<form method="post" asp-action="Edit" asp-route-id="@Model.Id">
    <input type="hidden" name="Id" value="@Model.Id" />
    <div class="row g-3" style="max-width: 600px;">

        <div class="col-12">
            <label class="form-label fw-semibold">Name (English)</label>
            <input type="text" name="NameEn" class="form-control" value="@Model.NameEn" required />
        </div>

        <div class="col-md-6">
            <label class="form-label">Building Cost Modifier</label>
            <input type="number" name="BuildingCostModifier" class="form-control" step="0.01"
                   value="@Model.BuildingCostModifier" required />
        </div>

        <div class="col-md-6">
            <label class="form-label">Starting Gold</label>
            <input type="number" name="StartingGold" class="form-control" value="@Model.StartingGold" required />
        </div>

        <div class="col-md-6">
            <label class="form-label">Starting Food</label>
            <input type="number" name="StartingFood" class="form-control" value="@Model.StartingFood" required />
        </div>

        <div class="col-md-6">
            <label class="form-label">Starting Wood</label>
            <input type="number" name="StartingWood" class="form-control" value="@Model.StartingWood" required />
        </div>

        <div class="col-md-6">
            <label class="form-label">Starting Stone</label>
            <input type="number" name="StartingStone" class="form-control" value="@Model.StartingStone" required />
        </div>

        <div class="col-md-6">
            <label class="form-label">Starting Mana</label>
            <input type="number" name="StartingMana" class="form-control" value="@Model.StartingMana" required />
        </div>

        <div class="col-12">
            <label class="form-label">Description</label>
            <textarea name="Description" class="form-control" rows="3">@Model.Description</textarea>
        </div>

        <div class="col-12">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
        </div>

    </div>
</form>
