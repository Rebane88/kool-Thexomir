@model IEnumerable<Domain.Factions.FactionType>
@inject IStringLocalizer<Common> Localizer
@{
    ViewData["Title"] = Localizer["FactionTypes_Title"].Value;
}

<div class="page-header">
    <h1>@Localizer["FactionTypes_Title"]</h1>
    <a asp-action="Create" class="btn-admin btn-primary-admin">@Localizer["FactionTypes_Add"]</a>
</div>

<div class="admin-card" style="padding:0; overflow:hidden;">
    <table class="admin-table">
        <thead>
            <tr>
                <th>@Localizer["Field_Name"]</th>
                <th>@Localizer["FactionTypes_Atk"]</th>
                <th>@Localizer["FactionTypes_HP"]</th>
                <th>@Localizer["FactionTypes_Init"]</th>
                <th>@Localizer["FactionTypes_ChipDmg"]</th>
                <th>@Localizer["FactionTypes_ResProd"]</th>
                <th>@Localizer["FactionTypes_BldCost"]</th>
                <th>@Localizer["FactionTypes_TrainCost"]</th>
                <th>@Localizer["FactionTypes_AP"]</th>
                <th>@Localizer["FactionTypes_Heal"]</th>
                <th>@Localizer["FactionTypes_Bonus"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td style="font-weight:500;">@item.Name.Translate()</td>
                    <td>@item.AttackModifier</td>
                    <td>@item.HPModifier</td>
                    <td>@item.InitiativeModifier</td>
                    <td>@item.ChipDamageModifier</td>
                    <td>@item.ResourceProductionModifier</td>
                    <td>@item.BuildingCostModifier</td>
                    <td>@item.TrainingCostModifier</td>
                    <td>@item.ActionPointModifier</td>
                    <td>@item.HealRateModifier</td>
                    <td>
                        @if (item.StartingBonusResource.HasValue)
                        {
                            <span>@item.StartingBonusResource +@item.StartingBonusAmount</span>
                        }
                        else
                        {
                            <span style="color:#a1a1aa;">—</span>
                        }
                    </td>
                    <td>
                        <div class="d-flex gap-1">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn-admin">@Localizer["Form_Edit"]</a>
                            <form method="post" asp-action="Delete" asp-route-id="@item.Id" class="d-inline"
                                  onsubmit="return confirm('@Localizer["FactionTypes_ConfirmDelete"]')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-admin btn-danger-admin">@Localizer["Form_Delete"]</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>