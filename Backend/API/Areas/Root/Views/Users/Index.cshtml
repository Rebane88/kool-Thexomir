@model IEnumerable<API.Areas.Root.ViewModels.UserListViewModel>
@inject IStringLocalizer<Common> Localizer
@{
    ViewData["Title"] = Localizer["Nav_Users"].Value;
}

<div class="page-header">
    <h1>@Localizer["Nav_Users"]</h1>
</div>

<div class="admin-card" style="padding:0; overflow:hidden;">
    <table class="admin-table">
        <thead>
            <tr>
                <th>@Localizer["Users_Email"]</th>
                <th>@Localizer["Users_Username"]</th>
                <th>@Localizer["Users_Roles"]</th>
                <th>@Localizer["Users_Status"]</th>
                <th>@Localizer["Users_Registered"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td style="font-weight:500;">@user.Email</td>
                    <td>@user.UserName</td>
                    <td>
                        @if (user.Roles.Any())
                        {
                            @string.Join(", ", user.Roles)
                        }
                        else
                        {
                            <span style="color:#a1a1aa;">@Localizer["Users_None"]</span>
                        }
                    </td>
                    <td>
                        @if (user.IsLockedOut)
                        {
                            <span class="badge-status badge-danger">@Localizer["Users_Locked"]</span>
                        }
                        else
                        {
                            <span class="badge-status badge-success">@Localizer["Users_Active"]</span>
                        }
                    </td>
                    <td>@user.CreatedAt.ToString("yyyy-MM-dd")</td>
                    <td>
                        <div class="d-flex flex-wrap gap-1">
                            @if (!user.Roles.Contains("Admin"))
                            {
                                <form method="post" asp-action="RoleAdd" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    <input type="hidden" name="role" value="Admin" />
                                    <button type="submit" class="btn-admin">@Localizer["Users_AddAdmin"]</button>
                                </form>
                            }
                            else
                            {
                                <form method="post" asp-action="RoleRemove" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    <input type="hidden" name="role" value="Admin" />
                                    <button type="submit" class="btn-admin btn-danger-admin">@Localizer["Users_RemoveAdmin"]</button>
                                </form>
                            }

                            @if (user.IsLockedOut)
                            {
                                <form method="post" asp-action="UnlockUser" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <button type="submit" class="btn-admin">@Localizer["Users_Unlock"]</button>
                                </form>
                            }
                            else
                            {
                                <form method="post" asp-action="LockUser" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <button type="submit" class="btn-admin btn-danger-admin">@Localizer["Users_Lock"]</button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>