@inject IStringLocalizer<Common> Localizer
@{
    ViewData["Title"] = Localizer["Dashboard_Title"].Value;
}

<div class="page-header">
    <h1>@Localizer["Dashboard_Title"]</h1>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="admin-card">
            <div style="font-weight:600; margin-bottom:0.35rem;">@Localizer["Nav_Users"]</div>
            <p style="font-size:0.8rem; color:#71717a; margin-bottom:0.75rem;">@Localizer["Dashboard_UsersDesc"]</p>
            <a asp-area="Root" asp-controller="Users" asp-action="Index" class="btn-admin btn-primary-admin">
                @Localizer["Dashboard_Manage"]
            </a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="admin-card">
            <div style="font-weight:600; margin-bottom:0.35rem;">@Localizer["Nav_Games"]</div>
            <p style="font-size:0.8rem; color:#71717a; margin-bottom:0.75rem;">@Localizer["Dashboard_GamesDesc"]</p>
            <a asp-area="Root" asp-controller="Games" asp-action="Index" class="btn-admin btn-primary-admin">
                @Localizer["Dashboard_View"]
            </a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="admin-card">
            <div style="font-weight:600; margin-bottom:0.35rem;">@Localizer["Nav_ReferenceData"]</div>
            <p style="font-size:0.8rem; color:#71717a; margin-bottom:0.75rem;">@Localizer["Dashboard_RefDataDesc"]</p>
            <div class="d-flex flex-wrap gap-1">
                <a asp-area="Root" asp-controller="FactionTypes" asp-action="Index" class="btn-admin">@Localizer["Dashboard_Factions"]</a>
                <a asp-area="Root" asp-controller="TerrainTypes" asp-action="Index" class="btn-admin">@Localizer["Dashboard_Terrain"]</a>
                <a asp-area="Root" asp-controller="BuildingTypes" asp-action="Index" class="btn-admin">@Localizer["Dashboard_Buildings"]</a>
                <a asp-area="Root" asp-controller="ArmyTypes" asp-action="Index" class="btn-admin">@Localizer["Dashboard_Armies"]</a>
                <a asp-area="Root" asp-controller="GameEvents" asp-action="Index" class="btn-admin">@Localizer["Dashboard_Events"]</a>
            </div>
        </div>
    </div>
</div>