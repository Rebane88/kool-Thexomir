@model IEnumerable<API.Areas.Root.ViewModels.GameListViewModel>
@inject IStringLocalizer<Common> Localizer
@{
    ViewData["Title"] = Localizer["Games_ActiveGames"].Value;
}

<div class="page-header">
    <h1>@Localizer["Games_ActiveGames"]</h1>
</div>

@if (!Model.Any())
{
    <div class="admin-card">
        <p style="color:#71717a; margin:0;">@Localizer["Games_NoActiveGames"]</p>
    </div>
}
else
{
    <div class="admin-card" style="padding:0; overflow:hidden;">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>@Localizer["Games_LobbyCode"]</th>
                    <th>@Localizer["Games_Host"]</th>
                    <th>@Localizer["Games_Players"]</th>
                    <th>@Localizer["Games_Status"]</th>
                    <th>@Localizer["Games_Created"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var game in Model)
                {
                    <tr>
                        <td><code style="background:#f4f4f5; padding:0.15rem 0.4rem; border-radius:4px; font-size:0.8rem;">@game.LobbyCode</code></td>
                        <td>@(game.HostName ?? Localizer["Games_Unknown"].Value)</td>
                        <td>@game.PlayerCount / @game.MaxPlayers</td>
                        <td>
                            @if (game.Status == Domain.Game.EGameStatus.Lobby)
                            {
                                <span class="badge-status badge-info">@Localizer["Games_Lobby"]</span>
                            }
                            else
                            {
                                <span class="badge-status badge-warning">@Localizer["Games_InProgress"]</span>
                            }
                        </td>
                        <td>@game.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <a asp-action="ForceClose" asp-route-id="@game.Id" class="btn-admin btn-danger-admin">
                                @Localizer["Games_ForceClose"]
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}