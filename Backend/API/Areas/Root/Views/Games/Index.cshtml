@model IEnumerable<API.Areas.Root.ViewModels.GameListViewModel>
@{
    ViewData["Title"] = "Active Games";
}

<h1 class="h3 mb-4">Active Games</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <p class="text-muted">No active games at this time.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Lobby Code</th>
                    <th>Host</th>
                    <th>Players</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var game in Model)
                {
                    <tr>
                        <td><code>@game.LobbyCode</code></td>
                        <td>@(game.HostName ?? "Unknown")</td>
                        <td>@game.PlayerCount / @game.MaxPlayers</td>
                        <td>
                            @if (game.Status == Domain.Game.EGameStatus.Lobby)
                            {
                                <span class="badge bg-info text-dark">Lobby</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">In Progress</span>
                            }
                        </td>
                        <td>@game.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <a asp-action="ForceClose" asp-route-id="@game.Id" class="btn btn-outline-danger btn-sm">
                                Force Close
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
