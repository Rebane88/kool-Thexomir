@model API.Areas.Root.ViewModels.GameListViewModel
@inject IStringLocalizer<Common> Localizer
@{
    ViewData["Title"] = Localizer["Games_ForceCloseTitle"].Value;
}

<div class="page-header">
    <h1>@Localizer["Games_ForceCloseTitle"]</h1>
</div>

<div class="admin-card" style="max-width:560px;">
    <div style="background:#fee2e2; border:1px solid #fecaca; border-radius:6px; padding:0.75rem 1rem; margin-bottom:1.25rem; font-size:0.8rem; color:#991b1b;">
        @Localizer["Games_ForceCloseWarning"]
    </div>

    <table class="admin-table" style="margin-bottom:1.25rem;">
        <tbody>
            <tr><td style="font-weight:600; width:120px;">@Localizer["Games_LobbyCode"]</td><td><code>@Model.LobbyCode</code></td></tr>
            <tr><td style="font-weight:600;">@Localizer["Games_Host"]</td><td>@(Model.HostName ?? Localizer["Games_Unknown"].Value)</td></tr>
            <tr><td style="font-weight:600;">@Localizer["Games_Players"]</td><td>@Model.PlayerCount / @Model.MaxPlayers</td></tr>
            <tr><td style="font-weight:600;">@Localizer["Games_Status"]</td><td>@Model.Status</td></tr>
            <tr><td style="font-weight:600;">@Localizer["Games_Created"]</td><td>@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td></tr>
        </tbody>
    </table>

    <div class="d-flex gap-2">
        <form method="post" asp-action="ForceClose" asp-route-id="@Model.Id">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn-admin btn-danger-solid">@Localizer["Games_YesForceClose"]</button>
        </form>
        <a asp-action="Index" class="btn-admin">@Localizer["Form_Cancel"]</a>
    </div>
</div>