@{
    ViewData["Title"] = "Create Building Type";
}

<h2>Create Building Type</h2>
<hr />

<form method="post" asp-action="Create">
    <div class="row g-3" style="max-width: 700px;">

        <div class="col-12">
            <label class="form-label fw-semibold">Name (English)</label>
            <input type="text" name="NameEn" class="form-control" required />
        </div>

        <div class="col-md-4">
            <label class="form-label">Tier</label>
            <input type="number" name="Tier" class="form-control" value="1" required />
        </div>

        <div class="col-md-8">
            <label class="form-label">Chain</label>
            <input type="text" name="Chain" class="form-control" placeholder="e.g. farm, barracks" />
        </div>

        <div class="col-12"><hr class="my-1" /><small class="text-muted">Costs</small></div>

        <div class="col-md-3">
            <label class="form-label">Gold</label>
            <input type="number" name="GoldCost" class="form-control" value="0" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Wood</label>
            <input type="number" name="WoodCost" class="form-control" value="0" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Stone</label>
            <input type="number" name="StoneCost" class="form-control" value="0" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Mana</label>
            <input type="number" name="ManaCost" class="form-control" value="0" />
        </div>

        <div class="col-12"><hr class="my-1" /><small class="text-muted">Yields (per turn)</small></div>

        <div class="col-md-4">
            <label class="form-label">Food Yield</label>
            <input type="number" name="FoodYield" class="form-control" value="0" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Wood Yield</label>
            <input type="number" name="WoodYield" class="form-control" value="0" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Stone Yield</label>
            <input type="number" name="StoneYield" class="form-control" value="0" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Gold Yield</label>
            <input type="number" name="GoldYield" class="form-control" value="0" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Mana Yield</label>
            <input type="number" name="ManaYield" class="form-control" value="0" />
        </div>

        <div class="col-12"><hr class="my-1" /></div>

        <div class="col-12">
            <label class="form-label">Description</label>
            <textarea name="Description" class="form-control" rows="2"></textarea>
        </div>

        <div class="col-md-6">
            <label class="form-label">Icon URL</label>
            <input type="text" name="IconUrl" class="form-control" />
        </div>

        <div class="col-md-6">
            <label class="form-label">Prerequisite Building Type ID</label>
            <input type="text" name="PrerequisiteBuildingTypeId" class="form-control"
                   placeholder="Leave blank if none" />
        </div>

        <div class="col-12">
            <button type="submit" class="btn btn-primary">Create</button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
        </div>

    </div>
</form>
