@model dynamic
@inject IStringLocalizer<Common> Localizer
@{
    ViewData["Title"] = Localizer["BuildingTypes_Edit"].Value;
}

<div class="page-header">
    <h1>@Localizer["BuildingTypes_Edit"]</h1>
</div>

<div class="admin-card">
    <form method="post" asp-action="Edit" asp-route-id="@Model.Id" class="admin-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@Model.Id" />
        <div class="row g-3">

            <div class="col-12"><div class="form-section-label">@Localizer["Field_Name"]</div></div>

            <div class="col-md-6">
                <label class="form-label">@Localizer["Field_Name"] (EN)</label>
                <input type="text" name="NameEn" class="form-control" value="@Model.NameEn" required />
            </div>
            <div class="col-md-6">
                <label class="form-label">@Localizer["Field_Name"] (ET)</label>
                <input type="text" name="NameEt" class="form-control" value="@Model.NameEt" />
            </div>

            <div class="col-md-4">
                <label class="form-label">@Localizer["BuildingTypes_Tier"]</label>
                <input type="number" name="Tier" class="form-control" value="@Model.Tier" required />
            </div>
            <div class="col-md-8">
                <label class="form-label">@Localizer["BuildingTypes_Chain"]</label>
                <input type="text" name="Chain" class="form-control" value="@Model.Chain" />
            </div>

            <div class="col-12"><div class="form-section-label">@Localizer["BuildingTypes_Costs"]</div></div>

            <div class="col">
                <label class="form-label">@Localizer["BuildingTypes_Gold"]</label>
                <input type="number" name="CostGold" class="form-control" value="@Model.CostGold" />
            </div>
            <div class="col">
                <label class="form-label">@Localizer["BuildingTypes_Food"]</label>
                <input type="number" name="CostFood" class="form-control" value="@Model.CostFood" />
            </div>
            <div class="col">
                <label class="form-label">@Localizer["BuildingTypes_Wood"]</label>
                <input type="number" name="CostWood" class="form-control" value="@Model.CostWood" />
            </div>
            <div class="col">
                <label class="form-label">@Localizer["BuildingTypes_Stone"]</label>
                <input type="number" name="CostStone" class="form-control" value="@Model.CostStone" />
            </div>
            <div class="col">
                <label class="form-label">@Localizer["BuildingTypes_Mana"]</label>
                <input type="number" name="CostMana" class="form-control" value="@Model.CostMana" />
            </div>

            <div class="col-12"><div class="form-section-label">@Localizer["BuildingTypes_BaseYields"]</div></div>

            <div class="col">
                <label class="form-label">@Localizer["BuildingTypes_Gold"]</label>
                <input type="number" name="BaseYieldGold" class="form-control" value="@Model.BaseYieldGold" />
            </div>
            <div class="col">
                <label class="form-label">@Localizer["BuildingTypes_Food"]</label>
                <input type="number" name="BaseYieldFood" class="form-control" value="@Model.BaseYieldFood" />
            </div>
            <div class="col">
                <label class="form-label">@Localizer["BuildingTypes_Wood"]</label>
                <input type="number" name="BaseYieldWood" class="form-control" value="@Model.BaseYieldWood" />
            </div>
            <div class="col">
                <label class="form-label">@Localizer["BuildingTypes_Stone"]</label>
                <input type="number" name="BaseYieldStone" class="form-control" value="@Model.BaseYieldStone" />
            </div>
            <div class="col">
                <label class="form-label">@Localizer["BuildingTypes_Mana"]</label>
                <input type="number" name="BaseYieldMana" class="form-control" value="@Model.BaseYieldMana" />
            </div>

            <div class="col-12"><div class="form-section-label">@Localizer["BuildingTypes_Other"]</div></div>

            <div class="col-md-4">
                <label class="form-label">@Localizer["BuildingTypes_ArmyCapacity"]</label>
                <input type="number" name="ArmyCapacity" class="form-control" value="@Model.ArmyCapacity" />
            </div>
            <div class="col-md-8">
                <label class="form-label">@Localizer["BuildingTypes_UnlockedBy"]</label>
                <input type="text" name="UnlockedByBuildingTypeId" class="form-control"
                       value="@Model.UnlockedByBuildingTypeId" placeholder="@Localizer["Field_Optional"]" />
            </div>

            <div class="col-md-6">
                <label class="form-label">@Localizer["Field_Description"] (EN)</label>
                <textarea name="DescriptionEn" class="form-control" rows="2">@Model.DescriptionEn</textarea>
            </div>
            <div class="col-md-6">
                <label class="form-label">@Localizer["Field_Description"] (ET)</label>
                <textarea name="DescriptionEt" class="form-control" rows="2">@Model.DescriptionEt</textarea>
            </div>
            <div class="col-12">
                <label class="form-label">@Localizer["Field_IconUrl"]</label>
                <input type="text" name="IconUrl" class="form-control" value="@Model.IconUrl" placeholder="@Localizer["Field_Optional"]" />
            </div>

            <div class="col-12 d-flex gap-2 mt-2">
                <button type="submit" class="btn-admin btn-primary-admin">@Localizer["Form_Save"]</button>
                <a asp-action="Index" class="btn-admin">@Localizer["Form_Cancel"]</a>
            </div>

        </div>
    </form>
</div>