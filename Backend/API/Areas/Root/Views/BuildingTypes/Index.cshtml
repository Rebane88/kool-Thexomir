@model IEnumerable<Domain.Buildings.BuildingType>
@inject IStringLocalizer<Common> Localizer
@{
    ViewData["Title"] = Localizer["BuildingTypes_Title"].Value;
}

<div class="page-header">
    <h1>@Localizer["BuildingTypes_Title"]</h1>
    <a asp-action="Create" class="btn-admin btn-primary-admin">@Localizer["BuildingTypes_Add"]</a>
</div>

<div class="admin-card" style="padding:0; overflow:hidden;">
    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>@Localizer["Field_Name"]</th>
                    <th>@Localizer["BuildingTypes_Tier"]</th>
                    <th>@Localizer["BuildingTypes_Chain"]</th>
                    <th colspan="5" style="text-align:center;">@Localizer["BuildingTypes_Costs"]</th>
                    <th colspan="5" style="text-align:center;">@Localizer["BuildingTypes_BaseYields"]</th>
                    <th>@Localizer["BuildingTypes_ArmyCap"]</th>
                    <th></th>
                </tr>
                <tr>
                    <th></th><th></th><th></th>
                    <th>G</th><th>F</th><th>W</th><th>S</th><th>M</th>
                    <th>G</th><th>F</th><th>W</th><th>S</th><th>M</th>
                    <th></th><th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td style="font-weight:500;">@item.Name.Translate()</td>
                        <td>@item.Tier</td>
                        <td>@item.Chain</td>
                        <td>@item.CostGold</td>
                        <td>@item.CostFood</td>
                        <td>@item.CostWood</td>
                        <td>@item.CostStone</td>
                        <td>@item.CostMana</td>
                        <td>@item.BaseYieldGold</td>
                        <td>@item.BaseYieldFood</td>
                        <td>@item.BaseYieldWood</td>
                        <td>@item.BaseYieldStone</td>
                        <td>@item.BaseYieldMana</td>
                        <td>@item.ArmyCapacity</td>
                        <td>
                            <div class="d-flex gap-1">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn-admin">@Localizer["Form_Edit"]</a>
                                <form method="post" asp-action="Delete" asp-route-id="@item.Id" class="d-inline"
                                      onsubmit="return confirm('@Localizer["BuildingTypes_ConfirmDelete"]')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-admin btn-danger-admin">@Localizer["Form_Delete"]</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>