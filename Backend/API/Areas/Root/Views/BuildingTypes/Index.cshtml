@model IEnumerable<Domain.Buildings.BuildingType>
@{
    ViewData["Title"] = "Building Types";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Building Types</h2>
    <a asp-action="Create" class="btn btn-primary">Add Building Type</a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="table-responsive">
    <table class="table table-striped table-sm">
        <thead>
            <tr>
                <th>Name</th>
                <th>Tier</th>
                <th>Chain</th>
                <th>Gold</th>
                <th>Food</th>
                <th>Wood</th>
                <th>Stone</th>
                <th>Mana</th>
                <th>Gold Yield</th>
                <th>Food Yield</th>
                <th>Army Cap</th>
                <th>Description</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name.Translate("en")</td>
                    <td>@item.Tier</td>
                    <td>@item.Chain</td>
                    <td>@item.CostGold</td>
                    <td>@item.CostFood</td>
                    <td>@item.CostWood</td>
                    <td>@item.CostStone</td>
                    <td>@item.CostMana</td>
                    <td>@item.BaseYieldGold</td>
                    <td>@item.BaseYieldFood</td>
                    <td>@item.ArmyCapacity</td>
                    <td>@item.Description</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form method="post" asp-action="Delete" asp-route-id="@item.Id" class="d-inline"
                              onsubmit="return confirm('Delete this building type?')">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
