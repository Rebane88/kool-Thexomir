<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Realms of Ash Admin — @ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        .sidebar {
            position: sticky;
            top: 0;
            height: 100vh;
            padding-top: 1rem;
            overflow-y: auto;
        }
        .sidebar .nav-link {
            color: #adb5bd;
            padding: 0.5rem 1rem;
        }
        .sidebar .nav-link:hover,
        .sidebar .nav-link.active {
            color: #fff;
        }
        .sidebar-heading {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.1rem;
            color: #6c757d;
            padding: 0.5rem 1rem;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <nav class="col-md-2 d-none d-md-block bg-dark sidebar min-vh-100">
                <div class="pt-3">
                    <div class="px-3 mb-3">
                        <span class="text-white fw-bold fs-6">Realms of Ash Admin</span>
                    </div>
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Root" asp-controller="Home" asp-action="Index">
                                Dashboard
                            </a>
                        </li>
                        <li class="sidebar-heading mt-2">Management</li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Root" asp-controller="Users" asp-action="Index">
                                Users
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Root" asp-controller="Games" asp-action="Index">
                                Active Games
                            </a>
                        </li>
                        <li class="sidebar-heading mt-2">Reference Data</li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Root" asp-controller="FactionTypes" asp-action="Index">
                                Faction Types
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Root" asp-controller="TerrainTypes" asp-action="Index">
                                Terrain Types
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Root" asp-controller="BuildingTypes" asp-action="Index">
                                Building Types
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Root" asp-controller="UnitTypes" asp-action="Index">
                                Unit Types
                            </a>
                        </li>
                    </ul>
                    <div class="mt-4 px-3">
                        <partial name="_AdminLanguageSelection" />
                    </div>
                    <div class="mt-2 px-3">
                        <form method="post" asp-area="Root" asp-controller="Account" asp-action="Logout">
                            <button type="submit" class="btn btn-outline-secondary btn-sm w-100 text-white">
                                Logout
                            </button>
                        </form>
                    </div>
                </div>
            </nav>

            <!-- Main content -->
            <main class="col-md-10 ms-sm-auto px-4 py-3">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
