@using Domain.Map
@{
    ViewData["Title"] = "Create Terrain Type";
}

<h2>Create Terrain Type</h2>
<hr />

<form method="post" asp-action="Create">
    <div class="row g-3" style="max-width: 500px;">

        <div class="col-12">
            <label class="form-label fw-semibold">Name (English)</label>
            <input type="text" name="NameEn" class="form-control" required />
        </div>

        <div class="col-md-6">
            <label class="form-label">Defense Bonus</label>
            <input type="number" name="DefenseBonus" class="form-control" step="0.01" value="0.00" required />
        </div>

        <div class="col-md-6">
            <label class="form-label">Movement Cost</label>
            <input type="number" name="MovementCost" class="form-control" value="1" required />
        </div>

        <div class="col-12">
            <label class="form-label">Resource Bonus Type</label>
            <select name="ResourceBonusType" class="form-select">
                @foreach (var value in Enum.GetValues<ETerrainResourceBonus>())
                {
                    <option value="@value">@value</option>
                }
            </select>
        </div>

        <div class="col-12">
            <button type="submit" class="btn btn-primary">Create</button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
        </div>

    </div>
</form>
